{{ if .is_windows }}
# chezmoi cannot execute .sh scripts on Windows
.chezmoiscripts/*.sh
# Helix reads %APPDATA%\helix on Windows (deployed via AppData/Roaming/helix)
.config/helix
# herdr reads %APPDATA%\herdr on Windows (deployed via AppData/Roaming/herdr)
.config/herdr
# Lazygit reads %LOCALAPPDATA%\lazygit on Windows (deployed via AppData/Local/lazygit)
.config/lazygit
{{ end }}

{{/*
  WezTerm runs natively on Windows and on a Linux desktop only.
  Inside WSL it runs on the Windows host, and headless Linux servers have no GUI,
  so drop the config in those cases.
*/}}
{{ if not (or .is_windows (and .is_pure_linux .is_desktop)) }}
.wezterm.lua
**/wezterm
{{ end }}
