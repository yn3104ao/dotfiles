// Common settings
show_startup_tips false
auto_layout true
update_check false
mouse_mode true
copy_on_select true

default-layout "compact"


keybinds {
    tmux clear-defaults=true {
        bind "Ctrl b" { SwitchToMode "Normal"; }

        bind "l" {
            Run "fend" {
                floating true
                close_on_exit true
            };
            SwitchToMode "Normal"
        }

        bind "k" {
            LaunchOrFocusPlugin "local:send-key" {
                payload "Enter"
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }

        bind "m" {
            LaunchOrFocusPlugin "local:monocle" {
                floating true
            };
            SwitchToMode "Normal";
        }

        bind "f" {
            LaunchOrFocusPlugin "zellij:strider " {
                floating true
            };
            SwitchToMode "Normal";
        }

        bind "y" {
            LaunchOrFocusPlugin "local:zellij_forgot" {
                "buy eggs" "5x"
                "learn rust" "5h"
                "clean up code" "tomorrow"
                floating true
                move_to_focused_tab true
            };
        }
    }

    pane { unbind "c"; }
}

