// Common settings
show_startup_tips false
auto_layout true
update_check false
mouse_mode true
copy_on_select true

simplified_ui true
ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

theme "catppuccin_mocha"

keybinds {
    tmux clear-defaults=true {
        bind "Ctrl b" { SwitchToMode "Normal"; }

        bind "l" {
            Run "fend" {
                floating true
                close_on_exit true
            };
            SwitchToMode "Normal"
        }

        bind "k" {
            LaunchOrFocusPlugin "local:send-key" {
                payload "Enter"
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }

        bind "m" {
            LaunchOrFocusPlugin "local:monocle" {
                floating true
                move_to_focused_tab true
                close_on_exit true
            };
            SwitchToMode "Normal";
        }

        bind "f" {
            LaunchOrFocusPlugin "zellij:strider " {
                floating true
                move_to_focused_tab true
                close_on_exit true
            };
            SwitchToMode "Normal";
        }

        bind "y" {
            LaunchOrFocusPlugin "local:zellij_forgot" {
                "buy eggs" "5x"
                "learn rust" "5h"
                "clean up code" "tomorrow"
                floating true
                move_to_focused_tab true
                close_on_exit true
            };
        }
    }
}

plugins {
    local:monocle location="file:$HOME/.config/zellij/plugins/monocle.wasm"
    local:send-keys location="file:$HOME/.config/zellij/plugins/zellij-send-key.wasm"
    local:zellij-forgot location="file:$HOME/.config/zellij/plugins/zellij_forgot.wasm"
    local:zjstatus location="file:$HOME/.config/zellij/plugins/zjstatus.wasm"
}
