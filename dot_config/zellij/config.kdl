// theme "term_sync"

theme "catppuccin_mocha"

simplified_ui true
ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}


plugins {
    local:monocle location="file:$HOME/.config/zellij/plugins/monocle.wasm"
    local:send-keys location="file:$HOME/.config/zellij/plugins/zellij-send-key.wasm"
    local:zellij-forgot location="file:$HOME/zellij-plugins/zellij_forgot.wasm"
    local:zjstatus location="file:$HOME/zellij-plugins/zjstatus.wasm"
}
