// Common settings
show_startup_tips false
auto_layout true
update_check false
mouse_mode true
copy_on_select true

default-layout "compact"


keybinds {
    unbind "Ctrl b" // Reset the default once

    normal {
        bind "Ctrl b" "l" {
            Run "fend" {
                floating true
                close_on_exit true
            };
            SwitchToMode "Normal"
        }

        bind "Ctrl b" "k" {
            LaunchOrFocusPlugin "send-key" {
                payload "Enter"
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }

        bind "Ctrl b" "m" {
            LaunchOrFocusPlugin "monocle" {
                floating true
            };
            SwitchToMode "Normal";
        }

        bind "Ctrl b" "f" {
            LaunchOrFocusPlugin "strider " {
                floating true
            };
            SwitchToMode "Normal";
        }
    }

    pane { unbind "c"; }

    shared_except "locked" {
        bind "Ctrl b" { SwitchToMode "Locked"; }

        bind "Ctrl y" {
            LaunchOrFocusPlugin "zellij_forgot" {
                "buy eggs" "5x"
                "learn rust" "5h"
                "clean up code" "tomorrow"
                floating true
                move_to_focused_tab true
            };
        }
    }

    locked {
        bind "Ctrl b" { SwitchToMode "Normal"; }
    }
}

