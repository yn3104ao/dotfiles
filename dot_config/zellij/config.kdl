// theme "term_sync"
theme "catppuccin_mocha"

simplified_ui true
ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

// Hyprland's Scratchpad-like floating pane
keybinds {
    locked {
        // Press Ctrl+b -> f to always bring the terminal to the center.
        bind "Ctrl b" "f" { ToggleFloatingPanes; SwitchToMode "Locked"; }
    }
}

plugins {
    monocle location="file:~/.config/zellij/plugins/monocle.wasm"
    send-keys location="file:~/.config/zellij/plugins/zellij-send-key.wasm"
    zellij-forgot location="file:~/zellij-plugins/zellij_forgot.wasm"
    zjstatus location="file:~/zellij-plugins/zjstatus.wasm"
}
