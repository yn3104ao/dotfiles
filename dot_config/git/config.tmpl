[user]
    name = {{ .git_name }}
    email = {{ .git_email }}
    {{ if not (and .is_pure_linux (not .is_desktop)) -}}
    {{ if eq .profile "work" -}}
    signingkey = "{{ onepasswordRead "op://Employee/id_ed25519/public key" }}"
    {{ else if eq .profile "personal" }}
    signingkey = "{{ onepasswordRead "op://Personal/GitHub - Signing/public key" }}"
    {{ end -}}
    {{ end }}

    # A little "annoyance" setting in case the email address is emptys
    {{ if not .git_email }}
    useConfigOnly = true
    {{ end }}

[merge]
    tool = "vscode"

[difftool "vscode"]
    cmd = "code --wait --new-window --diff \"$LOCAL\" \"$REMOTE\""

[mergetool "vscode"]
    cmd = "code --wait --new-window --merge \"$MERGED\""
    trustExitCode = true
    keepBackup = false

[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f

[credential]
    gitHubAccountFiltering = false
    helper = "!gh auth git-credential"

[gpg]
    format = ssh

[gpg.ssh]
    {{ if .is_windows }}
        program = "/mnt/c/Users/{{ .chezmoi.username }}/AppData/Local/Microsoft/WindowsApps/op-ssh.exe"
    {{ else if .is_wsl }}
        program = "/mnt/c/Users/{{ .chezmoi.username }}/AppData/Local/Microsoft/WindowsApps/op-ssh-wsl.exe"
    {{ else if .is_desktop }}
        program = "/opt/1Password/op-ssh-sign"
    {{ else }}
    {{ end }}

[commit]
    {{ if and .is_pure_linux (not .is_desktop) }}
    gpgsign = false
    {{ else }}
    gpgsign = true
    {{ end }}

[core]
    autocrlf = false
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = false
    line-numbers = true

[alias]
    fpush = push --force-with-lease --force-if-includes
    mrebase = rebase --rebase-merges
    comit = !echo \"Use jj instead\" && false
