{{ if .is_windows -}}
{{ template "windows/prelude.ps1" . }}
$script:ScriptName = 'ssh-hosts-hint.ps1'

Write-Step 'To connect to other machines from WezTerm (Ctrl+Shift+L), add them to ~/.ssh/config by hand.'
