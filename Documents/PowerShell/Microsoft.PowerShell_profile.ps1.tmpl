{{ if .is_windows }}
# ----- mise -----
if (Get-Command mise -ErrorAction SilentlyContinue) {
    mise activate pwsh | Out-String | Invoke-Expression
}

# ----- fzf -----
$script:FzfCommand = (Get-Command fzf -CommandType Application -ErrorAction SilentlyContinue).Source

# ----- starship -----
if (Get-Command starship -ErrorAction SilentlyContinue) {
    Invoke-Expression (&starship init powershell)
}

# ----- atuin -----
if ((Get-Command atuin -ErrorAction SilentlyContinue) -and (Get-Module -ListAvailable -Name PSReadLine)) {
    Invoke-Expression (& { (atuin init powershell | Out-String) })
    # The init script always binds Up to atuin (no --disable-up-arrow equivalent); keep Up as plain history, Ctrl+R only for atuin
    Set-PSReadLineKeyHandler -Chord UpArrow -Function PreviousHistory
}

# ----- zoxide -----
if (Get-Command zoxide -ErrorAction SilentlyContinue) {
    Invoke-Expression (& { (zoxide init powershell --cmd cd | Out-String) })
}

# ----- Aliases / functions -----
if (Get-Command eza -ErrorAction SilentlyContinue) {
    Remove-Item Alias:ls -Force -ErrorAction SilentlyContinue
    function global:ls { eza --icons @args }
    function global:ll { eza -lah --icons @args }
    function global:tree { eza --tree --icons @args }
}

if (Get-Command bat -ErrorAction SilentlyContinue) {
    Remove-Item Alias:cat -Force -ErrorAction SilentlyContinue
    function global:cat { bat @args }
}

if (Get-Command rg -ErrorAction SilentlyContinue) {
    Remove-Item Alias:grep -Force -ErrorAction SilentlyContinue
    function global:grep { rg @args }
}

if (Get-Command fd -ErrorAction SilentlyContinue) {
    function global:find { fd @args }
}

if (Get-Command dust -ErrorAction SilentlyContinue) {
    function global:du { dust -r -d 1 @args }
}

if (Get-Command git -ErrorAction SilentlyContinue) {
    function global:gg { git @args }
}

if (Get-Command zellij -ErrorAction SilentlyContinue) {
    function global:zlj { zellij @args }
}

if ($script:FzfCommand -and (Get-Command bat -ErrorAction SilentlyContinue)) {
    function global:fzf { & $script:FzfCommand --preview 'bat --color=always --style=numbers --line-range=:500 {}' @args }
}

if (Get-Command yazi -ErrorAction SilentlyContinue) {
    function global:y {
        $tmp = [System.IO.Path]::GetTempFileName()
        try {
            yazi @args --cwd-file="$tmp"
            $cwd = Get-Content -LiteralPath $tmp -Raw -Encoding UTF8
            if (-not [String]::IsNullOrWhiteSpace($cwd)) {
                $cwd = $cwd.TrimEnd("`r", "`n")
                if ($cwd -ne $PWD.Path) {
                    Set-Location -LiteralPath $cwd
                }
            }
        } finally {
            Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
        }
    }
}

if ((Get-Command gwq -ErrorAction SilentlyContinue) -and $script:FzfCommand) {
    function global:gw {
        $worktrees = gwq list -g --json | Out-String
        if ($LASTEXITCODE -ne 0 -or -not $worktrees.TrimStart().StartsWith('[')) { return }
        $target = $worktrees | ConvertFrom-Json | ForEach-Object { $_.path } |
            & $script:FzfCommand --no-preview --prompt='Worktree > ' --height=40% --layout=reverse
        if ($LASTEXITCODE -eq 0 -and $target) {
            Set-Location -LiteralPath $target
        }
    }
}

# ----- safe-chain -----
if (Test-Path (Join-Path $HOME '.safe-chain\scripts\init-pwsh.ps1')) {
    . (Join-Path $HOME '.safe-chain\scripts\init-pwsh.ps1')
}
{{ end }}
