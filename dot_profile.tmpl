# Environment variables only (read by login shells); interactive setup lives in ~/.bashrc

# ----- PATH -----
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

{{ if .is_wsl }}
export PATH="/mnt/c/Program Files/Git/bin:$PATH"
{{ end }}

# ----- container -----
export TESTCONTAINERS_RYUK_DISABLED=true
if [ -f "/run/k3s/containerd/containerd.sock" ]; then
export DOCKER_HOST=unix:///run/k3s/containerd/containerd.sock
fi

# ----- mise -----
export MISE_STRICT=0
export MISE_USE_VERSIONS_HOST=1
{{ if not .is_windows }}
# shims make the tools visible to non-interactive login shells (e.g. `bash -l -c zellij`)
if command -v mise > /dev/null 2>&1; then
    eval "$(mise activate bash --shims)"
fi
{{ end }}

# ----- 1Password SSH agent-----
{{ if .is_wsl }}
export SSH_AUTH_SOCK="/mnt/c/Users/{{ .chezmoi.username }}/AppData/Local/1Password/app/ssh-agent.sock"
{{ end }}

{{ if .is_windows }}
# ----- zellij -----
# Same location as the PowerShell profile (zellij defaults to %APPDATA%\Zellij on Windows)
export ZELLIJ_CONFIG_DIR="$HOME/.config/zellij"
{{ end }}

{{ if .is_wsl }}
# ----- wslu -----
if command -v wslusc > /dev/null 2>&1; then
    export BROWSER='wslusc'
fi
{{ end }}

export DOTFILES_PROFILE_LOADED=1
