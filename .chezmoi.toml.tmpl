{{- $profile := promptStringOnce . "profile" "What profile is this? (work.personal)" "personal" -}}
{{- $git_name := promptStringOnce . "git_name" "Git username" -}}
{{- $git_email := promptStringOnce . "git_email" "Git email" -}}

{{- $osId := .chezmoi.os -}}
{{- $is_windows :=  eq $osId "windows" -}}
{{- $is_linux :=  eq $osId "linux" -}}
{{- $is_wsl :=  false -}}
{{- if $is_linux -}}
{{-     if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{-         $is_wsl = true }}
{{-     end -}}
{{- end -}}
{{- $is_pure_linux := and $is_linux (not $is_wsl) -}}

{{/* Desktop vs server. Windows and WSL are always treated as desktop. */}}
{{/* Pure Linux is auto-detected (GUI session or 1Password desktop app) and */}}
{{/* can be overridden interactively via promptBoolOnce.                    */}}
{{- $is_desktop := true -}}
{{- if $is_pure_linux -}}
{{-     $detected := false -}}
{{-     if or (env "DISPLAY") (env "WAYLAND_DISPLAY") -}}
{{-         $detected = true -}}
{{-     end -}}
{{-     if stat "/opt/1Password" -}}
{{-         $detected = true -}}
{{-     end -}}
{{-     $is_desktop = promptBoolOnce . "is_desktop" "Is this a desktop (GUI) machine?" $detected -}}
{{- end -}}

[data]
    profile = {{ $profile | quote }}
    git_name = {{ $git_name | quote }}
    git_email = {{ $git_email | quote }}
    is_windows = {{ $is_windows }}
    is_linux = {{ $is_linux }}
    is_wsl = {{ $is_wsl }}
    is_pure_linux = {{ $is_pure_linux }}
    is_desktop = {{ $is_desktop }}
